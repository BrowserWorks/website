---
import Default from "@astrojs/starlight/components/Head.astro";
import type { Props } from "@astrojs/starlight/props";
import BlogJsonLd from "./BlogJsonLd.astro";

const pageUrl = new URL(Astro.url);
const pathname = pageUrl.pathname;

let ogImageUrl: URL;

if (
	pathname === "/" ||
	pathname === "/index.html" ||
	pathname === "/blog/" ||
	pathname === "/blog/index.html"
) {
	ogImageUrl = new URL("/index/og.png", pageUrl);
} else {
	try {
		const ogPath = pathname.endsWith("/")
			? `${pathname}og.png`
			: `${pathname}/og.png`;

		ogImageUrl = new URL(ogPath, pageUrl);
	} catch {
		ogImageUrl = new URL("/index/og.png", pageUrl);
	}
}

const isBlogPost =
	pathname.includes("/blog/") &&
	pathname !== "/docs/blog/" &&
	pathname !== "/docs/blog/index.html" &&
	pathname !== "/blog/" &&
	pathname !== "/blog/index.html";
---

<Default {...Astro.props}><slot /></Default>
<meta property="og:image" content={ogImageUrl} />
<meta name="twitter:image" content={ogImageUrl} />

{isBlogPost && (
  <BlogJsonLd
    entry={Astro.props.entry}
    url={Astro.url}
    siteUrl={Astro.site || 'https://www.waterfox.net'}
    ogImageUrl={ogImageUrl}
  />
)}
